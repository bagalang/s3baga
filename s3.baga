    return concat(s, "-----END CERTIFICATE-----\n")
}

fn s3_anchor_der() -> bytes !IO {
    let f = str_trim(env("S3_TLS_ANCHOR_FILE")?)
    if f != "" {
        if file_readable(f)? == 1 {
            let pem = read_file(f)?
            return pem_der_block(pem, "CERTIFICATE")
        }
    }
    return pem_der_block(s3_anchor_pem(), "CERTIFICATE")
}

fn s3_exchange(url_host: str, https: i64, port: i64, header: str, body: bytes, timeout: i64) -> S3Out !Net !IO !Random {
    let wire = bytes_concat(bytes_of_str(header), body)
    if https == 0 {
        let fd = tcp_connect_to(url_host, port, timeout)?
        if fd < 0 {
            return s3_fail("s3: connect failed")
        }
        let w = tcp_write_bytes(fd, wire)?
        if w != 0 {
            tcp_close(fd)?
            return s3_fail("s3: write failed")
        }
        let buf = s3_read_tcp(fd)?
        tcp_close(fd)?
        return s3_parse(buf)
    }
    let anchor = s3_anchor_der()?
    let conn = tls_connect(url_host, port, timeout, anchor)?
    if conn.ok == 0 {
        let mut why = conn.err
        if why == "" {
            why = "tls failed"
        }
        return s3_fail(concat("s3: ", why))
    }
    let sent = tls_conn_write(conn, wire)?
    if sent.ok == 0 {
        tls_conn_close(sent)?
        return s3_fail("s3: tls write failed")
    }
    let rd = tls_conn_read_app(sent)?
    tls_conn_close(rd.conn)?
    if rd.conn.ok == 0 && bytes_len(rd.data) == 0 {
        return s3_fail("s3: tls read failed")
    }
    return s3_parse(rd.data)
}

fn s3_host_header(host: str, port: i64, https: i64) -> str {
    if https == 1 && port == 443 {
        return host
    }
    if https == 0 && port == 80 {
        return host
    }
    return concat(concat(host, ":"), int_to_str(port))
}

struct S3Cfg {
    endpoint: str,
    bucket: str,
    access: str,
    secret: str,
    region: str,
    timeout_s: i64
}

fn s3_cfg(endpoint: str, bucket: str, access: str, secret: str, region: str, timeout_s: i64) -> S3Cfg {
    return S3Cfg {
        endpoint: endpoint,
        bucket: bucket,
        access: access,
        secret: secret,
        region: region,
        timeout_s: timeout_s
    }
}

fn s3_cfg_env() -> S3Cfg !IO {
    return s3_cfg(
        str_trim(env("S3_ENDPOINT")?),
        str_trim(env("S3_BUCKET")?),
        env("S3_ACCESS_KEY")?,
        env("S3_SECRET_KEY")?,
        s3_region()?,
        s3_timeout()?
    )
}

fn s3_call_cfg(cfg: S3Cfg, method: str, key: str, body: bytes) -> S3Out !Net !IO !Random !Time {
    let endpoint = str_trim(cfg.endpoint)
    let bucket = str_trim(cfg.bucket)
    let access = cfg.access
    let secret = cfg.secret
    if endpoint == "" || bucket == "" || access == "" || secret == "" {
        return s3_fail("s3: missing endpoint, bucket, access key or secret key")
    }
    let u = http_parse_url(endpoint)
    if u.ok == 0 {
        return s3_fail("s3: bad endpoint")
    }
    let mut region = str_trim(cfg.region)
    if region == "" {
        region = "us-east-1"
    }
    let mut timeout = cfg.timeout_s
    if timeout < 1 {
        timeout = 30
    }
    let host = s3_host_header(u.host, u.port, u.https)
    let uri = concat(concat(concat("/", bucket), "/"), key)
    let amz = s3_amz_date(time_now_ms() / 1000)
    let ph = s3_payload_hash(body)
    let auth = s3_authorization(access, secret, region, method, uri, host, amz, ph)
    let mut h = method
    h = concat(h, " ")
    h = concat(h, uri)
    h = concat(h, " HTTP/1.1\r\nHost: ")
    h = concat(h, host)
    h = concat(h, "\r\nx-amz-date: ")
    h = concat(h, amz)
    h = concat(h, "\r\nx-amz-content-sha256: ")
    h = concat(h, ph)
    h = concat(h, "\r\nAuthorization: ")
    h = concat(h, auth)
    h = concat(h, "\r\nContent-Length: ")
    h = concat(h, int_to_str(bytes_len(body)))
    h = concat(h, "\r\nConnection: close\r\n\r\n")
    return s3_exchange(u.host, u.https, u.port, h, body, timeout)?
}

fn s3_call(method: str, key: str, body: bytes) -> S3Out !Net !IO !Random !Time {
    return s3_call_cfg(s3_cfg_env()?, method, key, body)?
}

fn s3_put_cfg(cfg: S3Cfg, key: str, body: bytes) -> S3Out !Net !IO !Random !Time {
    let r = s3_call_cfg(cfg, "PUT", key, body)?
    if r.ok == 0 {
        return r
    }
    if r.status == 200 {
        return r
    }
    if r.status == 204 {
        return r
    }
    return S3Out { ok: 0, status: r.status, body: r.body, err: concat("s3: put ", int_to_str(r.status)) }
}

fn s3_put(key: str, body: bytes) -> S3Out !Net !IO !Random !Time {
    return s3_put_cfg(s3_cfg_env()?, key, body)?
}

fn s3_get_cfg(cfg: S3Cfg, key: str) -> S3Out !Net !IO !Random !Time {
    return s3_call_cfg(cfg, "GET", key, bytes_new(0))?
}

fn s3_get(key: str) -> S3Out !Net !IO !Random !Time {
    return s3_get_cfg(s3_cfg_env()?, key)?
}

fn s3_delete_cfg(cfg: S3Cfg, key: str) -> S3Out !Net !IO !Random !Time {
    let r = s3_call_cfg(cfg, "DELETE", key, bytes_new(0))?
    if r.ok == 0 {
        return r
    }
    if r.status == 200 {
        return S3Out { ok: 1, status: r.status, body: bytes_new(0), err: "" }
    }
    if r.status == 204 {
        return S3Out { ok: 1, status: r.status, body: bytes_new(0), err: "" }
    }
    if r.status == 404 {
        return S3Out { ok: 1, status: r.status, body: bytes_new(0), err: "" }
    }
    return S3Out { ok: 0, status: r.status, body: r.body, err: concat("s3: delete ", int_to_str(r.status)) }
}

fn s3_delete(key: str) -> S3Out !Net !IO !Random !Time {
    return s3_delete_cfg(s3_cfg_env()?, key)?
}

fn s3_head_cfg(cfg: S3Cfg, key: str) -> S3Out !Net !IO !Random !Time {
    return s3_call_cfg(cfg, "HEAD", key, bytes_new(0))?
}

fn s3_head(key: str) -> S3Out !Net !IO !Random !Time {
    return s3_head_cfg(s3_cfg_env()?, key)?
}

// GET /{bucket}?query. query е вече каноничен (подреден и escape-нат).
fn s3_get_query(cfg: S3Cfg, query: str) -> S3Out !Net !IO !Random !Time {
    let endpoint = str_trim(cfg.endpoint)
    let bucket = str_trim(cfg.bucket)
    let access = cfg.access
    let secret = cfg.secret
    if endpoint == "" || bucket == "" || access == "" || secret == "" {
        return s3_fail("s3: missing endpoint, bucket, access key or secret key")
    }
    let u = http_parse_url(endpoint)
    if u.ok == 0 {
        return s3_fail("s3: bad endpoint")
    }
    let mut region = str_trim(cfg.region)
    if region == "" {
        region = "us-east-1"
    }
    let mut timeout = cfg.timeout_s
    if timeout < 1 {
        timeout = 30
    }
    let host = s3_host_header(u.host, u.port, u.https)
    let uri = concat("/", bucket)
    let body = bytes_new(0)
    let amz = s3_amz_date(time_now_ms() / 1000)
    let ph = s3_payload_hash(body)
    let auth = s3_authorization_q(access, secret, region, "GET", uri, query, host, amz, ph)
    let mut target = uri
    if query != "" {
        target = concat(concat(uri, "?"), query)
    }
    let mut h = "GET "
    h = concat(h, target)
    h = concat(h, " HTTP/1.1\r\nHost: ")
    h = concat(h, host)
    h = concat(h, "\r\nx-amz-date: ")
    h = concat(h, amz)
    h = concat(h, "\r\nx-amz-content-sha256: ")
    h = concat(h, ph)
    h = concat(h, "\r\nAuthorization: ")
    h = concat(h, auth)
    h = concat(h, "\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
    return s3_exchange(u.host, u.https, u.port, h, body, timeout)?
}

fn s3_list_query(prefix: str, token: str) -> str {
    let p = s3_query_escape(prefix)
    let mut q = ""
    if token != "" {
        q = concat("continuation-token=", s3_query_escape(token))
        q = concat(q, "&")
    }
    q = concat(q, "list-type=2&max-keys=1000&prefix=")
    return concat(q, p)
}

fn s3_list_cfg(cfg: S3Cfg, prefix: str, token: str) -> S3Out !Net !IO !Random !Time {
    return s3_get_query(cfg, s3_list_query(prefix, token))?
}

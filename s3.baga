// s3.baga — path-style S3 PUT/GET/DELETE/HEAD. Binary bodies stay bytes.

import "sign.baga"
import "std/net/tcp.baga"
import "std/net/tls_conn.baga"
import "std/net/http_client.baga"
import "std/str/str.baga"
import "std/bytes/bytes.baga"
import "std/os/os.baga"
import "std/time/time.baga"
import "std/crypto/pkey.baga"

struct S3Out {
    ok: i64,
    status: i64,
    body: bytes,
    err: str
}

fn s3_fail(err: str) -> S3Out {
    return S3Out { ok: 0, status: 0, body: bytes_new(0), err: err }
}

fn s3_timeout() -> i64 !IO {
    let raw = env("S3_TIMEOUT_S")?
    if raw == "" {
        return 30
    }
    let n = parse_int(raw)
    if n < 1 {
        return 30
    }
    return n
}

fn s3_region() -> str !IO {
    let r = str_trim(env("S3_REGION")?)
    if r == "" {
        return "us-east-1"
    }
    return r
}

fn s3_hdr_end(buf: bytes) -> i64 {
    let n = bytes_len(buf)
    let mut i: i64 = 0
    while i + 3 < n {
        if bytes_at(buf, i) == 13 && bytes_at(buf, i + 1) == 10 && bytes_at(buf, i + 2) == 13 && bytes_at(buf, i + 3) == 10 {
            return i
        }
        i = i + 1
    }
    return -1
}

fn s3_status_of(line: str) -> i64 {
    let sp = str_find(line, " ")
    if sp < 0 {
        return 0
    }
    let rest = substr(line, sp + 1, len(line))
    let sp2 = str_find(rest, " ")
    if sp2 < 0 {
        return parse_int(rest)
    }
    return parse_int(substr(rest, 0, sp2))
}

fn s3_lower(s: str) -> str {
    let mut out = ""
    let mut i: i64 = 0
    while i < len(s) {
        let mut c = char_at(s, i)
        if c >= 65 && c <= 90 {
            c = c + 32
        }
        out = concat(out, chr(c))
        i = i + 1
    }
    return out
}

fn s3_header_val(head: str, name: str) -> str {
    let low = s3_lower(head)
    let key = concat(s3_lower(name), ":")
    let at = str_find(low, key)
    if at < 0 {
        return ""
    }
    let rest = substr(head, at + len(key), len(head))
    let nl = str_find(rest, "\r")
    if nl < 0 {
        return str_trim(rest)
    }
    return str_trim(substr(rest, 0, nl))
}

fn s3_parse(buf: bytes) -> S3Out {
    let end = s3_hdr_end(buf)
    if end < 0 {
        return s3_fail("s3: short response")
    }
    let head = str_of_bytes(bytes_slice(buf, 0, end))
    let nl = str_find(head, "\r")
    let mut line = head
    if nl >= 0 {
        line = substr(head, 0, nl)
    }
    let status = s3_status_of(line)
    let mut body = bytes_slice(buf, end + 4, bytes_len(buf))
    let cl = s3_header_val(head, "content-length")
    if cl != "" {
        let n = parse_int(cl)
        if n >= 0 && n <= bytes_len(body) {
            body = bytes_slice(body, 0, n)
        }
    }
    return S3Out { ok: 1, status: status, body: body, err: "" }
}

fn s3_read_tcp(fd: i64) -> bytes !Net !IO {
    let mut buf = bytes_new(0)
    let mut reading: i64 = 1
    while reading == 1 {
        let chunk = tcp_read_bytes(fd, 8192)?
        if bytes_len(chunk) == 0 {
            reading = 0
        } else {
            buf = bytes_concat(buf, chunk)
        }
    }
    return buf
}

// Let's Encrypt YR1 — прекият издател на листовия сертификат на
// s3.*.backblazeb2.com. Клиентът пази само листото, затова котвата е
// издателят (същият подход като ЕЦБ в bagabuch). При ротация:
// S3_TLS_ANCHOR_FILE=<pem път>.
fn s3_anchor_pem() -> str {
    let mut s = "-----BEGIN CERTIFICATE-----\n"
    s = concat(s, "MIIE2zCCAsOgAwIBAgIRAKICU/FfJpHAXcHOE7m8yk4wDQYJKoZIhvcNAQELBQAw\n")
    s = concat(s, "LjELMAkGA1UEBhMCVVMxDTALBgNVBAoTBElTUkcxEDAOBgNVBAMTB1Jvb3QgWVIw\n")
    s = concat(s, "HhcNMjUwOTAzMDAwMDAwWhcNMjgwOTAyMjM1OTU5WjAzMQswCQYDVQQGEwJVUzEW\n")
    s = concat(s, "MBQGA1UEChMNTGV0J3MgRW5jcnlwdDEMMAoGA1UEAxMDWVIxMIIBIjANBgkqhkiG\n")
    s = concat(s, "9w0BAQEFAAOCAQ8AMIIBCgKCAQEAoVi8X2xCYgMXvJxNPKp/oF13UMgmPABB07VC\n")
    s = concat(s, "LNDtoXmt9luEZNJSBV10VyT1Pz6LD8Zq1d2gc43WNl1AdRrj4sEnazbOiz0nPpmG\n")
    s = concat(s, "Bp2hui49oZtDIY6wdKeZAi5BbNU20CH6RSBBMLSQ9cXrH8dxdv4PAJ45ssGML68U\n")
    s = concat(s, "SE3BsjC2a6cAN9L5CgXVIQi5tfNiTPoFZZ3S0OlXqLmmtdV95udWAb5b6e/F49Di\n")
    s = concat(s, "CsH0Y00Ag72BVIb1hzynmKe+X0mERBTtsb3BwmpV9ipeBjMLoR/D9cHxHQCWoi5l\n")
    s = concat(s, "TmXwY015J5rGelz1nZjJuxc2kioaX29XJBnhMkP531rSdG5uMwIDAQABo4HuMIHr\n")
    s = concat(s, "MA4GA1UdDwEB/wQEAwIBhjATBgNVHSUEDDAKBggrBgEFBQcDATASBgNVHRMBAf8E\n")
    s = concat(s, "CDAGAQH/AgEAMB0GA1UdDgQWBBQfLzW+RhSCzUCxrnksVXj699Ro+zAfBgNVHSME\n")
    s = concat(s, "GDAWgBTe51tg0CJtQCh9Pw0B/qS1UrRRlDAyBggrBgEFBQcBAQQmMCQwIgYIKwYB\n")
    s = concat(s, "BQUHMAKGFmh0dHA6Ly95ci5pLmxlbmNyLm9yZy8wEwYDVR0gBAwwCjAIBgZngQwB\n")
    s = concat(s, "AgEwJwYDVR0fBCAwHjAcoBqgGIYWaHR0cDovL3lyLmMubGVuY3Iub3JnLzANBgkq\n")
    s = concat(s, "hkiG9w0BAQsFAAOCAgEA0+zvMq3kHig1ddTmmm+RibTr9/RpX7k4buanMMRqbV/y\n")
    s = concat(s, "IvP82zAHN3mvaw+cASuVsdpd0ikjhr4hnhJQLQOzOp2ccKrsdGOAgo0vddeISFAq\n")
    s = concat(s, "EWEV4lmUM3vFF796up+bSgmJ1u6RupDCMxDgF8M3eLvGuj6L0lu3zkQ0KuQLnKxL\n")
    s = concat(s, "tB0oQqn1Idg5CuuGpMvQzk29Pa3D/qHurc0EIM9SxukQuJqq63lxsYyRQFU8yMBO\n")
    s = concat(s, "hq1w5LbfaWNRrz1uklOfI/pYkAb2E2MTZrAMQkBIE2S8Jt1F8gRc96o/xOsrgvSk\n")
    s = concat(s, "a84AisX6xq1lz1Z7jGvrnXc4TMcjxZTjiTaihcYI1JIXZiLtEMSCa5l3cu8YWd6z\n")
    s = concat(s, "dLRQlqRdclVjuQfNHawRJ6GWlkK0QJosivTKwdBw3KxEtzGo8yMHERbsy57gP1UX\n")
    s = concat(s, "HOMcmZYQC0gtyR3SxfenIM/MxC3Ia2Ypab/kQ/CTnlIn2KQ5JUC6NYrGCbhFN9bp\n")
    s = concat(s, "5lKJStEwCUnLpntcrXk5XVDCNv/5RyWpRThkGOV7GetKkQ0qAY8hCzWK6oqnAhDZ\n")
    s = concat(s, "cjlYVdWfqOw3DIOX6EDNBgAqHarRVxyF9QZdOaXSyPJ0ueD2BYJEBgaCGQ8rAaU/\n")

// sign.baga — AWS Signature Version 4 for S3 (path-style).
// Pure: the clock and the socket stay in the caller.

import "std/crypto/sha256.baga"
import "std/crypto/hmac.baga"
import "std/bytes/bytes.baga"
import "std/str/str.baga"

fn s3_empty_hash() -> str {
    return "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
}

fn s3_pad2(n: i64) -> str {
    if n < 10 {
        return concat("0", int_to_str(n))
    }
    return int_to_str(n)
}

fn s3_leap(y: i64) -> i64 {
    if y % 4 != 0 {
        return 0
    }
    if y % 100 != 0 {
        return 1
    }
    if y % 400 == 0 {
        return 1
    }
    return 0
}

fn s3_month_len(y: i64, m: i64) -> i64 {
    if m == 2 {
        if s3_leap(y) == 1 {
            return 29
        }
        return 28
    }
    if m == 4 || m == 6 || m == 9 || m == 11 {
        return 30
    }
    return 31
}

// Unix seconds → YYYYMMDDTHHMMSSZ. Only dates from 1970 onward.
fn s3_amz_date(epoch: i64) -> str {
    let mut days = epoch / 86400
    let sod = epoch % 86400
    let mut y: i64 = 1970
    let mut ylen = 365
    if s3_leap(y) == 1 {
        ylen = 366
    }
    while days >= ylen {
        days = days - ylen
        y = y + 1
        ylen = 365
        if s3_leap(y) == 1 {
            ylen = 366
        }
    }
    let mut m: i64 = 1
    let mut ml = s3_month_len(y, m)
    while days >= ml {
        days = days - ml
        m = m + 1
        ml = s3_month_len(y, m)
    }
    let d = days + 1
    let hh = sod / 3600
    let mm = (sod % 3600) / 60
    let ss = sod % 60
    let mut out = int_to_str(y)
    out = concat(out, s3_pad2(m))
    out = concat(out, s3_pad2(d))
    out = concat(out, "T")
    out = concat(out, s3_pad2(hh))
    out = concat(out, s3_pad2(mm))
    out = concat(out, s3_pad2(ss))
    return concat(out, "Z")
}

fn s3_date_stamp(amz: str) -> str {
    return substr(amz, 0, 8)
}

fn s3_hmac(key: bytes, msg: str) -> bytes {
    return hmac_sha256_b(key, bytes_of_str(msg))
}

fn s3_signing_key(secret: str, stamp: str, region: str, service: str) -> bytes {
    let k0 = s3_hmac(bytes_of_str(concat("AWS4", secret)), stamp)
    let k1 = s3_hmac(k0, region)
    let k2 = s3_hmac(k1, service)
    return s3_hmac(k2, "aws4_request")
}

fn s3_payload_hash(body: bytes) -> str {
    return sha256_b_hex(body)
}

fn s3_hex_digit(n: i64) -> str {
    if n < 10 {
        return chr(48 + n)
    }
    return chr(55 + n)
}

fn s3_query_unreserved(c: i64) -> i64 {
    if c >= 48 && c <= 57 {
        return 1
    }
    if c >= 65 && c <= 90 {
        return 1
    }
    if c >= 97 && c <= 122 {
        return 1
    }
    if c == 45 || c == 46 || c == 95 || c == 126 {
        return 1
    }
    return 0
}

// SigV4 query escape. Unreserved stays; everything else is %HH (uppercase).
fn s3_query_escape(s: str) -> str {
    let mut out = ""
    let mut i: i64 = 0
    while i < len(s) {
        let c = char_at(s, i)
        if s3_query_unreserved(c) == 1 {
            out = concat(out, chr(c))
        } else {
            let mut b = c
            if b < 0 {
                b = 0
            }
            if b > 255 {
                b = 255
            }
            out = concat(out, "%")
            out = concat(out, s3_hex_digit(b / 16))
            out = concat(out, s3_hex_digit(b % 16))
        }
        i = i + 1
    }
    return out
}

// Canonical request. query is already canonical (sorted, escaped) or empty.
fn s3_canonical_q(method: str, uri: str, query: str, host: str, amz_date: str, payload_hash: str) -> str {
    let mut s = method
    s = concat(s, "\n")
    s = concat(s, uri)
    s = concat(s, "\n")
    s = concat(s, query)
    s = concat(s, "\n")
    s = concat(s, "host:")
    s = concat(s, host)
    s = concat(s, "\n")
    s = concat(s, "x-amz-content-sha256:")
    s = concat(s, payload_hash)
    s = concat(s, "\n")
    s = concat(s, "x-amz-date:")
    s = concat(s, amz_date)
    s = concat(s, "\n\n")
    s = concat(s, "host;x-amz-content-sha256;x-amz-date\n")
    return concat(s, payload_hash)
}

fn s3_canonical(method: str, uri: str, host: str, amz_date: str, payload_hash: str) -> str {
    return s3_canonical_q(method, uri, "", host, amz_date, payload_hash)
}

fn s3_authorization_q(access: str, secret: str, region: str, method: str, uri: str, query: str, host: str, amz_date: str, payload_hash: str) -> str {
    let canon = s3_canonical_q(method, uri, query, host, amz_date, payload_hash)
    let ch = sha256_b_hex(bytes_of_str(canon))
    let stamp = s3_date_stamp(amz_date)
    let scope = concat(concat(concat(stamp, "/"), concat(region, "/s3/")), "aws4_request")
    let mut sts = "AWS4-HMAC-SHA256\n"
    sts = concat(sts, amz_date)
    sts = concat(sts, "\n")
    sts = concat(sts, scope)
    sts = concat(sts, "\n")
    sts = concat(sts, ch)
    let key = s3_signing_key(secret, stamp, region, "s3")
    let sig = hmac_sha256_b_hex(key, bytes_of_str(sts))
    let mut a = "AWS4-HMAC-SHA256 Credential="
    a = concat(a, access)
    a = concat(a, "/")
    a = concat(a, scope)
    a = concat(a, ", SignedHeaders=host;x-amz-content-sha256;x-amz-date, Signature=")
    return concat(a, sig)
}

fn s3_authorization(access: str, secret: str, region: str, method: str, uri: str, host: str, amz_date: str, payload_hash: str) -> str {
    return s3_authorization_q(access, secret, region, method, uri, "", host, amz_date, payload_hash)
}
